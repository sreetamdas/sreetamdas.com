// Project-specific Zed settings for sreetamdas.com.
// Mirrors the workspace conventions in .vscode/settings.json where Zed has
// equivalent settings: typescript-ls for JS/TS, Oxc for format/lint, and Tailwind CSS
// class detection in React helpers.
{
	"tab_size": 2,
	"hard_tabs": true,
	"lsp": {
		"vite-plus-fmt": {
			"command": {
				"path": "node_modules/.bin/vp",
				"arguments": ["fmt", "--lsp"]
			},
			"initialization_options": {
				"settings": {
					"fmt.configPath": "./vite.config.ts",
					"run": "onSave"
				}
			}
		},
		"vite-plus-lint": {
			"command": {
				"path": "node_modules/.bin/vp",
				"arguments": ["lint", "--lsp"]
			},
			"initialization_options": {
				"settings": {
					"configPath": "./vite.config.ts",
					"disableNestedConfig": false,
					"fixKind": "safe_fix",
					"run": "onType",
					"unusedDisableDirectives": "deny"
				}
			}
		},
		"tailwindcss-language-server": {
			"settings": {
				"tailwindCSS": {
					"classAttributes": ["class", "className", "ngClass", "tw"],
					"classFunctions": ["tw", "clsx", "cva", "cx", "cn"],
					"includeLanguages": {
						"plaintext": "html"
					}
				}
			}
		}
	},
	"languages": {
		"CSS": {
			"language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."],
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "vite-plus-fmt" } }]
		},
		"JavaScript": {
			"language_servers": [
				"typescript-ls",
				"tailwindcss-language-server",
				"vite-plus-fmt",
				"vite-plus-lint",
				"!vtsls",
				"..."
			],
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{ "language_server": { "name": "vite-plus-fmt" } },
				{ "code_action": "source.fixAll.oxc" }
			]
		},
		"TypeScript": {
			"language_servers": [
				"typescript-ls",
				"tailwindcss-language-server",
				"vite-plus-fmt",
				"vite-plus-lint",
				"!vtsls",
				"!typescript-language-server",
				"..."
			],
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{ "language_server": { "name": "vite-plus-fmt" } },
				{ "code_action": "source.fixAll.oxc" }
			]
		},
		"TSX": {
			"language_servers": [
				"typescript-ls",
				"tailwindcss-language-server",
				"vite-plus-fmt",
				"vite-plus-lint",
				"!vtsls",
				"!typescript-language-server",
				"..."
			],
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{ "language_server": { "name": "vite-plus-fmt" } },
				{ "code_action": "source.fixAll.oxc" }
			]
		},
		"JSON": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "vite-plus-fmt" } }]
		},
		"JSONC": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "vite-plus-fmt" } }]
		},
		"MDX": {
			"language_servers": ["mdx-analyzer", "tailwindcss-language-server", "vite-plus-fmt", "..."],
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "vite-plus-fmt" } }]
		}
	}
}
