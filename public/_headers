# Cloudflare Workers Assets serves prerendered HTML and hashed build output
# directly (before the Worker runs), so this file — not the Worker or route
# `headers()` — controls their caching.
#
# NOTE: Workers Assets *combines* (comma-joins) the headers of every rule whose
# pattern matches a request; a more specific rule does NOT override a broader
# one. Rules that need different values must first detach the broader rule's
# header with `! Header-Name` before setting their own.
#
# X-Foobar is the Foobar "headers" clue. The root route's headers() only reaches
# Worker-rendered pages, so prerendered pages such as /foobar need it here.
/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  Cloudflare-CDN-Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Foobar: /foobar/headers

/stats
  ! Cloudflare-CDN-Cache-Control
  Cloudflare-CDN-Cache-Control: public, max-age=60, stale-while-revalidate=600

/assets/*
  ! Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Iosevka subsets are content-hashed at build time (see font filenames), so
# they are safe to cache forever; a new build mints new URLs.
/fonts/iosevka/*
  ! Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The extensionless clue file would otherwise be served without a Content-Type.
/.well-known/foobar
  Content-Type: text/plain; charset=utf-8

/foobar-sw.js
  ! Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: no-cache
  Cloudflare-CDN-Cache-Control: no-store
