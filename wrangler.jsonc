{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sreetamdas-com",
	"compatibility_date": "2026-06-16",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker.ts",
	"workers_dev": true,
	"preview_urls": true,
	"durable_objects": {
		"bindings": [
			{
				"name": "SITE_PRESENCE",
				"class_name": "PresenceDurableObject"
			},
			{
				"name": "SLIDE_SESSIONS",
				"class_name": "SlideSessionDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "do-v1",
			"new_sqlite_classes": ["PresenceDurableObject"]
		},
		{
			"tag": "do-v2-slide-sessions",
			"new_sqlite_classes": ["SlideSessionDurableObject"]
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": false
		},
		"traces": {
			"enabled": true
		}
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"placement": {
		"mode": "smart"
	},
	"d1_databases": [
		{
			"database_name": "sreetamdas_com",
			"database_id": "94e03c24-095b-47e2-bdba-a53027348100",
			"binding": "D1",
			"preview_database_id": "sreetamdas_com_preview_default",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"services": [
		{
			"binding": "STATS",
			"service": "stats"
		},
		{
			"binding": "STATS_RPC",
			"service": "stats",
			"entrypoint": "StatsRpc"
		}
	],
	"vars": {
		"ANALYTICS_PROJECT_SLUG": "sreetamdas-com-prod"
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "2bc6cd0487714be58807514bc7c2003b",
			"preview_id": "sreetamdas_com_kv_preview_default"
		}
	],
	"env": {
		"staging": {
			"vars": {
				"ANALYTICS_PROJECT_SLUG": "sreetamdas-com-staging"
			},
			"services": [
				{
					"binding": "STATS",
					"service": "stats"
				},
				{
					"binding": "STATS_RPC",
					"service": "stats",
					"entrypoint": "StatsRpc"
				}
			],
			"routes": [
				{
					"custom_domain": true,
					"pattern": "dev.sreetamdas.com"
				},
				{
					"custom_domain": true,
					"pattern": "staging.sreetamdas.com"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "SITE_PRESENCE",
						"class_name": "PresenceDurableObject"
					},
					{
						"name": "SLIDE_SESSIONS",
						"class_name": "SlideSessionDurableObject"
					}
				]
			},
			"migrations": [
				{
					"tag": "do-v1",
					"new_sqlite_classes": ["PresenceDurableObject"]
				},
				{
					"tag": "do-v2-slide-sessions",
					"new_sqlite_classes": ["SlideSessionDurableObject"]
				}
			],
			"d1_databases": [
				{
					"database_name": "sreetamdas_com",
					"database_id": "94e03c24-095b-47e2-bdba-a53027348100",
					"binding": "D1",
					"preview_database_id": "sreetamdas_com_preview_staging"
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "2bc6cd0487714be58807514bc7c2003b",
					"preview_id": "sreetamdas_com_kv_preview_staging"
				}
			]
		},
		"production": {
			"vars": {
				"ANALYTICS_PROJECT_SLUG": "sreetamdas-com-prod"
			},
			"services": [
				{
					"binding": "STATS",
					"service": "stats"
				},
				{
					"binding": "STATS_RPC",
					"service": "stats",
					"entrypoint": "StatsRpc"
				}
			],
			"routes": [
				{
					"custom_domain": true,
					"pattern": "sreetamdas.com"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "SITE_PRESENCE",
						"class_name": "PresenceDurableObject"
					},
					{
						"name": "SLIDE_SESSIONS",
						"class_name": "SlideSessionDurableObject"
					}
				]
			},
			"migrations": [
				{
					"tag": "do-v1",
					"new_sqlite_classes": ["PresenceDurableObject"]
				},
				{
					"tag": "do-v2-slide-sessions",
					"new_sqlite_classes": ["SlideSessionDurableObject"]
				}
			],
			"d1_databases": [
				{
					"database_name": "sreetamdas_com",
					"database_id": "94e03c24-095b-47e2-bdba-a53027348100",
					"binding": "D1",
					"preview_database_id": "sreetamdas_com_preview_production"
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "2bc6cd0487714be58807514bc7c2003b",
					"preview_id": "sreetamdas_com_kv_preview_production"
				}
			]
		}
	}
}
