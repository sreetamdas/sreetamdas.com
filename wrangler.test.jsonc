{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sreetamdas-com-tests",
	"main": "./src/testing/worker-test-entry.ts",
	"compatibility_date": "2026-05-10",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"PRESENCE_HEARTBEAT_INTERVAL_MS": "100"
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "sreetamdas_com_tests",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SITE_PRESENCE",
				"class_name": "PresenceDurableObject"
			},
			{
				"name": "SLIDE_SESSIONS",
				"class_name": "SlideSessionDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "do-v1",
			"new_sqlite_classes": ["PresenceDurableObject"]
		},
		{
			"tag": "do-v2-slide-sessions",
			"new_sqlite_classes": ["SlideSessionDurableObject"]
		}
	]
}
